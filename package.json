{
  "name": "dsh-plugin-hop",
  "version": "0.4.2",
  "description": "跨机接力：把项目连同会话、待办和附件带到另一台装了 DSH 的电脑上继续。",
  "type": "module",
  "license": "MIT",
  "author": "spark",
  "homepage": "https://gitee.com/two-flower-world/dsh-hop",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/two-flower-world/dsh-hop.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "handoff",
    "sync"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.en.md",
    "client.js",
    "docs/images/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
